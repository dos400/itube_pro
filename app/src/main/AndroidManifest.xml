<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Settings → "Battery optimization" opens the system exemption dialog. Play Store
         restricts this permission; fine for a sideloaded app. Player permissions live in
         :core:player's manifest and are merged in. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app updates (system/ApkInstaller.kt). The user still has to allow
         "Install unknown apps" for itube pro once. UPDATE_PACKAGES_WITHOUT_USER_ACTION lets
         Android 12+ skip the confirmation dialog for later updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".ItubeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ItubePro">
        <!-- configChanges: Compose re-lays out on rotation/resizes by itself, so the activity
             isn't recreated. That keeps entering/leaving PiP and fullscreen landscape smooth
             (no flash, the PlayerView surface stays attached). State still survives process
             death via SavedStateHandle/rememberSaveable. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.ItubePro"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system's PackageInstaller calls this, through our own PendingIntent. -->
        <receiver
            android:name=".system.InstallStatusReceiver"
            android:exported="false" />
    </application>

</manifest>