<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground = ic_main.png (drawable/) cropped to the centre 1100 px and scaled to 432 px
     (108 dp at xxxhdpi), so the logo sits inside the 66 dp safe zone. No monochrome layer:
     a full-bleed bitmap would turn into a solid square when themed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
